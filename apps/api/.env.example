# ==============================================================================
# Solar CRM Backend API Environment Variables (apps/api)
# DO NOT commit real secrets or production credentials to source control.
# Set these variables securely in your hosting dashboard (Render / Railway / ECS / Fly).
# ==============================================================================

# ── 1. Server & Runtime ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
API_BASE_PATH=/api/v1

# ── 2. CORS & Allowed Origins ─────────────────────────────────────────────────
# Development: http://localhost:5173
# Staging:     https://staging.sunbeamsolar.in
# Production:  https://app.sunbeamsolar.in
CORS_ORIGIN=https://app.sunbeamsolar.in

# ── 3. Supabase Database & Auth (Server-Side Secrets) ─────────────────────────
# Development: http://localhost:54321
# Staging:     https://staging-ref.supabase.co
# Production:  https://your-prod-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (Bypasses RLS for authorized admin backend tasks — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (found in Supabase Dashboard > Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-string-at-least-32-chars

# ── 4. Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── 5. Integration Encryption Key ─────────────────────────────────────────────
# 32-byte AES-256 encryption key in hex for encrypting OAuth tokens at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── 6. Google Calendar & Google Meet OAuth ───────────────────────────────────
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Must exactly match Authorized redirect URIs in Google Cloud Console
# Development: http://localhost:5173/settings/integrations/google/callback
# Staging:     https://staging.sunbeamsolar.in/settings/integrations/google/callback
# Production:  https://app.sunbeamsolar.in/settings/integrations/google/callback
GOOGLE_REDIRECT_URI=https://app.sunbeamsolar.in/settings/integrations/google/callback

# ── 7. Email Dispatch (SMTP / AWS SES / SendGrid / Postmark) ─────────────────
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="Sunbeam Solar <notifications@sunbeamsolar.in>"

# ── 8. WhatsApp Cloud API (Meta for Developers) ──────────────────────────────
# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_API_TOKEN=EAAG...your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=109876543210123
