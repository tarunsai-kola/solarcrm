# ==============================================================================
# Solar CRM Frontend Environment Variables (apps/web)
# DO NOT commit production values or real secrets to version control.
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client.
# NEVER place service role keys, DB passwords, or OAuth client secrets in this file.
# ==============================================================================

# ── Supabase Public Configuration ─────────────────────────────────────────────
# Development: http://localhost:54321
# Staging:     https://staging-project-ref.supabase.co
# Production:  https://your-prod-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous Key (safe for browser exposure via RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Backend API Gateway ───────────────────────────────────────────────────────
# Development: /api/v1 (proxied via vite.config.ts to http://localhost:3001)
# Staging:     https://staging-api.sunbeamsolar.in/api/v1
# Production:  https://api.sunbeamsolar.in/api/v1 (or /api/v1 if routed via CDN reverse proxy)
VITE_API_BASE_URL=/api/v1

# ── Application Metadata & Feature Flags ──────────────────────────────────────
VITE_APP_NAME="Sunbeam Solar CRM"
VITE_APP_VERSION="1.0.0"

# Set to true only in development/debugging to output browser sourcemaps
VITE_SOURCEMAPS=false
