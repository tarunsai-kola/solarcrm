# Solar CRM — root .gitignore

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.turbo/
*.tsbuildinfo

# Environment files — NEVER commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Supabase local
supabase/.branches/
supabase/.temp/

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/

# Misc
.cache/
tmp/
